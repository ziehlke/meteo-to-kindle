# Copy to .env and fill in your value (Never commit the real .env!)
# Get an API key at https://developer.airly.eu/
AIRLY_KEY=your-airly-api-key-here

# Optional forecast model: um4_60 (default), um4_120 or gfs
# METEO_MODEL=um4_60

# Optional paths on the Raspberry Pi:
# METEO_OUTPUT_DIR=/home/dietpi/weather
# METEO_SHARE_PATH=/home/dietpi
